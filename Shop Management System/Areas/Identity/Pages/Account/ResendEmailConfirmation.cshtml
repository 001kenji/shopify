@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = "Resend email confirmation";
}

<div class="max-w-md mx-auto py-12">
    <h1 class="text-2xl font-bold text-gray-900">@ViewData["Title"]</h1>
    <p class="mt-2 text-sm text-gray-600">Enter your email.</p>
    <hr class="my-6 border-golden-100" />

    <form method="post" class="space-y-5">
        <div asp-validation-summary="All" class="text-sm text-red-600" role="alert"></div>

        <div>
            <label asp-for="Input.Email" class="form-label"></label>
            <input asp-for="Input.Email" class="form-input" aria-required="true"
                   placeholder="name@example.com" />
            <span asp-validation-for="Input.Email" class="mt-1 block text-xs text-red-600"></span>
        </div>

        <button type="submit" class="btn-primary">Resend</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}