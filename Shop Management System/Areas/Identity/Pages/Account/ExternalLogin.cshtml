@page
@model ExternalLoginModel
@{
    ViewData["Title"] = "Register";
}

<div class="max-w-md mx-auto py-12">
    <h1 class="text-2xl font-bold text-gray-900">@ViewData["Title"]</h1>
    <h2 class="mt-2 text-sm text-gray-600">
        Associate your <span class="font-semibold text-golden-600">@Model.ProviderDisplayName</span> account.
    </h2>
    <hr class="my-6 border-golden-100" />

    <p class="text-sm text-gray-700 mb-6">
        You've successfully authenticated with <strong>@Model.ProviderDisplayName</strong>.
        Please enter an email address for this site below and click the Register button to finish logging in.
    </p>

    <form asp-page-handler="Confirmation" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="space-y-5">
        <div asp-validation-summary="ModelOnly" class="text-sm text-red-600" role="alert"></div>

        <div>
            <label asp-for="Input.Email" class="form-label"></label>
            <input asp-for="Input.Email" class="form-input" autocomplete="email"
                   placeholder="name@example.com" />
            <span asp-validation-for="Input.Email" class="mt-1 block text-xs text-red-600"></span>
        </div>

        <button type="submit" class="btn-primary">Register</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}