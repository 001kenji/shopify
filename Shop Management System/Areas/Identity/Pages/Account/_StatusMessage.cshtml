@model string

@if (!String.IsNullOrEmpty(Model))
{
    var isError = Model.StartsWith("Error");
    var wrapper = isError
        ? "bg-red-50 border-red-200 text-red-800"
        : "bg-golden-50 border-golden-200 text-golden-800";
    var icon = isError ? "text-red-500" : "text-golden-500";

    <div class="flex items-start gap-3 border @wrapper rounded-md px-4 py-3 my-4" role="alert">
        <svg class="h-5 w-5 shrink-0 @icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            @if (isError)
            {
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M12 9v3m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z" />
            }
            else
            {
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            }
        </svg>
        <p class="text-sm">@Model</p>
    </div>
}