@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Reset password confirmation";
}

<div class="max-w-md mx-auto py-16 text-center">
    <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-golden-50">
        <svg class="h-7 w-7 text-golden-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
        </svg>
    </div>
    <h1 class="mt-4 text-2xl font-bold text-gray-900">@ViewData["Title"]</h1>
    <p class="mt-2 text-gray-600">
        Your password has been reset. Please
        <a asp-page="./Login" class="link-golden">click here to log in</a>.
    </p>
</div>