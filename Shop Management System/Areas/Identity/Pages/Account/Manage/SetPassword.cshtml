@page
@model SetPasswordModel
@{
    ViewData["Title"] = "Set password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h3 class="text-xl font-semibold text-gray-900">Set your password</h3>
<partial name="_StatusMessage" for="StatusMessage" />

<p class="mt-4 max-w-md text-sm text-golden-700 bg-golden-50 border border-golden-200 rounded-md px-4 py-3">
    You do not have a local username/password for this site. Add a local account so you can log in without an external login.
</p>

<form id="set-password-form" method="post" class="mt-6 max-w-md space-y-5">
    <div asp-validation-summary="ModelOnly" class="text-sm text-red-600" role="alert"></div>

    <div>
        <label asp-for="Input.NewPassword" class="form-label"></label>
        <input asp-for="Input.NewPassword" class="form-input" autocomplete="new-password"
               placeholder="Please enter your new password." />
        <span asp-validation-for="Input.NewPassword" class="mt-1 block text-xs text-red-600"></span>
    </div>

    <div>
        <label asp-for="Input.ConfirmPassword" class="form-label"></label>
        <input asp-for="Input.ConfirmPassword" class="form-input" autocomplete="new-password"
               placeholder="Please confirm your new password." />
        <span asp-validation-for="Input.ConfirmPassword" class="mt-1 block text-xs text-red-600"></span>
    </div>

    <button type="submit" class="btn-primary">Set password</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}