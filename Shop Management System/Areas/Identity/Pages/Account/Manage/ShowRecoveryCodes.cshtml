@page
@model ShowRecoveryCodesModel
@{
    ViewData["Title"] = "Recovery codes";
    ViewData["ActivePage"] = "TwoFactorAuthentication";
}

<h3 class="text-xl font-semibold text-gray-900">@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />

<div class="alert-warning mt-4 max-w-2xl">
    <div>
        <p><strong>Put these codes in a safe place.</strong></p>
        <p class="mt-2">If you lose your device and don't have the recovery codes you will lose access to your account.</p>
    </div>
</div>

<div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-3 max-w-md">
    @for (var row = 0; row < (Model.RecoveryCodes?.Length ?? 0); row += 2)
    {
        <code class="recovery-code text-center">@Model.RecoveryCodes![row]</code>
        @if (row + 1 < (Model.RecoveryCodes?.Length ?? 0))
        {
            <code class="recovery-code text-center">@Model.RecoveryCodes[row + 1]</code>
        }
    }
</div>