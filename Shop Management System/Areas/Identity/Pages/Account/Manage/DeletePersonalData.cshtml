@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "Delete Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h3 class="text-xl font-semibold text-gray-900">@ViewData["Title"]</h3>

<div class="alert-danger mt-4 max-w-2xl">
    <div>
        <strong>Deleting this data will permanently remove your account, and this cannot be recovered.</strong>
    </div>
</div>

<form id="delete-user" method="post" class="mt-6 max-w-md space-y-5">
    <div asp-validation-summary="ModelOnly" class="text-sm text-red-600" role="alert"></div>

    @if (Model.RequirePassword)
    {
        <div>
            <label asp-for="Input.Password" class="form-label"></label>
            <input asp-for="Input.Password" class="form-input" autocomplete="current-password"
                   aria-required="true" placeholder="Please enter your password." />
            <span asp-validation-for="Input.Password" class="mt-1 block text-xs text-red-600"></span>
        </div>
    }

    <button class="btn-danger w-full" type="submit">Delete data and close my account</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}