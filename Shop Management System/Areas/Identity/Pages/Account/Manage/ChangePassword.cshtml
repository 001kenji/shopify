@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h3 class="text-xl font-semibold text-gray-900">@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />

<form id="change-password-form" method="post" class="mt-6 max-w-md space-y-5">
    <div asp-validation-summary="ModelOnly" class="text-sm text-red-600" role="alert"></div>

    <div>
        <label asp-for="Input.OldPassword" class="form-label"></label>
        <input asp-for="Input.OldPassword" class="form-input" autocomplete="current-password"
               aria-required="true" placeholder="Please enter your old password." />
        <span asp-validation-for="Input.OldPassword" class="mt-1 block text-xs text-red-600"></span>
    </div>

    <div>
        <label asp-for="Input.NewPassword" class="form-label"></label>
        <input asp-for="Input.NewPassword" class="form-input" autocomplete="new-password"
               aria-required="true" placeholder="Please enter your new password." />
        <span asp-validation-for="Input.NewPassword" class="mt-1 block text-xs text-red-600"></span>
    </div>

    <div>
        <label asp-for="Input.ConfirmPassword" class="form-label"></label>
        <input asp-for="Input.ConfirmPassword" class="form-input" autocomplete="new-password"
               aria-required="true" placeholder="Please confirm your new password." />
        <span asp-validation-for="Input.ConfirmPassword" class="mt-1 block text-xs text-red-600"></span>
    </div>

    <button type="submit" class="btn-primary">Update password</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}