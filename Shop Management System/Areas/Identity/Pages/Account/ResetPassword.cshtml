@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
}

<div class="max-w-md mx-auto py-12">
    <h1 class="text-2xl font-bold text-gray-900">@ViewData["Title"]</h1>
    <p class="mt-2 text-sm text-gray-600">Reset your password.</p>
    <hr class="my-6 border-golden-100" />

    <form method="post" class="space-y-5">
        <div asp-validation-summary="ModelOnly" class="text-sm text-red-600" role="alert"></div>
        <input asp-for="Input.Code" type="hidden" />

        <div>
            <label asp-for="Input.Email" class="form-label"></label>
            <input asp-for="Input.Email" class="form-input" autocomplete="username"
                   aria-required="true" placeholder="name@example.com" />
            <span asp-validation-for="Input.Email" class="mt-1 block text-xs text-red-600"></span>
        </div>

        <div>
            <label asp-for="Input.Password" class="form-label"></label>
            <input asp-for="Input.Password" class="form-input" autocomplete="new-password"
                   aria-required="true" placeholder="Please enter your password." />
            <span asp-validation-for="Input.Password" class="mt-1 block text-xs text-red-600"></span>
        </div>

        <div>
            <label asp-for="Input.ConfirmPassword" class="form-label"></label>
            <input asp-for="Input.ConfirmPassword" class="form-input" autocomplete="new-password"
                   aria-required="true" placeholder="Please confirm your password." />
            <span asp-validation-for="Input.ConfirmPassword" class="mt-1 block text-xs text-red-600"></span>
        </div>

        <button type="submit" class="btn-primary">Reset</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}