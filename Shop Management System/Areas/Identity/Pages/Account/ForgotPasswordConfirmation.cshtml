@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Forgot password confirmation";
}

<div class="max-w-md mx-auto py-16 text-center">
    <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-golden-50">
        <svg class="h-7 w-7 text-golden-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M3 8l7.89 5.26a2 2 0 0 0 2.22 0L21 8M5 19h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2Z" />
        </svg>
    </div>
    <h1 class="mt-4 text-2xl font-bold text-gray-900">@ViewData["Title"]</h1>
    <p class="mt-2 text-gray-600">Please check your email to reset your password.</p>
    <a asp-page="./Login" class="mt-6 inline-block link-golden text-sm">Back to login</a>
</div>