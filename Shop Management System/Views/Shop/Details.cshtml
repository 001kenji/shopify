@model Shop_Management_System.Models.Inventory
@using Shop_Management_System.Extensions
@using Shop_Management_System.Models
@{
    ViewData["Title"] = Model.Name;

    var inStock = Model.Quantity > 0;
    var isDeliverable = Model.Is_Delivarable;
}

<div class="max-w-5xl mx-auto">

    <!-- Breadcrumb -->
    <nav class="text-sm text-gray-500 mb-6">
        <a asp-action="Index" class="hover:text-golden-600 transition-colors">Shop</a>
        <span class="mx-1">/</span>
        <span class="text-gray-700">@Model.Name</span>
    </nav>

    <div class="grid md:grid-cols-2 gap-8">

        <!-- Left: image -->
        <div class="card overflow-hidden relative">
            @if (!string.IsNullOrEmpty(Model.ImagePath))
            {
                <img src="@Model.ImagePath" alt="@Model.Name"
                     class="w-full h-96 object-cover" />
            }
            else
            {
                <div class="w-full h-96 flex items-center justify-center bg-golden-50 text-golden-400">
                    <svg class="h-20 w-20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                              d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0
                                 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2
                                 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                </div>
            }

            @if (!inStock)
            {
                <div class="absolute inset-0 bg-black/40 flex items-center justify-center">
                    <span class="rounded-full bg-white px-4 py-1.5 text-sm font-semibold text-gray-900">
                        Out of stock
                    </span>
                </div>
            }
        </div>

        <!-- Right: details -->
        <div class="flex flex-col">

            <!-- Category + stock badge -->
            <div class="flex flex-wrap items-center gap-2 mb-3">
                @if (Model.Categories.HasValue)
                {
                    <span class="inline-block rounded-full bg-golden-50 border border-golden-200
                                 px-3 py-0.5 text-xs font-medium text-golden-700">
                        @Model.Categories.Value.GetDisplayName()
                    </span>
                }

                @if (isDeliverable)
                {
                    <span class="inline-flex items-center gap-1 rounded-full bg-golden-50 border border-golden-200
                                 px-3 py-0.5 text-xs font-medium text-golden-700">
                        <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M3 7h11v8H3zM14 10h4l3 3v2h-7zM5.5 19a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Zm13 0a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z" />
                        </svg>
                        Delivery available
                    </span>
                }

                @if (inStock)
                {
                    <span class="inline-block rounded-full bg-green-50 border border-green-200
                                 px-3 py-0.5 text-xs font-medium text-green-700">
                        In stock
                    </span>
                }
                else
                {
                    <span class="inline-block rounded-full bg-red-50 border border-red-200
                                 px-3 py-0.5 text-xs font-medium text-red-700">
                        Out of stock
                    </span>
                }
            </div>

            <!-- Name -->
            <h1 class="text-3xl font-bold text-gray-900">@Model.Name</h1>

            <!-- Price -->
            <p class="mt-3 text-2xl font-bold text-golden-700">
                KES @Model.SellingPrice.ToString("N2")
                @if (!string.IsNullOrEmpty(Model.Unit))
                {
                    <span class="text-sm font-normal text-gray-500">/ @Model.Unit</span>
                }
            </p>

            <!-- Description -->
            <div class="mt-6">
                <h2 class="text-xs font-semibold text-gray-900 uppercase tracking-wide">Description</h2>
                <p class="mt-2 text-sm text-gray-600 whitespace-pre-line leading-relaxed">
                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        @Model.Description
                    }
                    else
                    {
                        <span class="text-gray-400">No description provided.</span>
                    }
                </p>
            </div>

            <!-- Spec table -->
            <dl class="mt-6 grid grid-cols-[140px_1fr] gap-x-4 gap-y-3 text-sm">
                <dt class="text-gray-500">Available</dt>
                <dd class="text-gray-900 font-medium">
                    @if (inStock)
                    {
                        @($"{Model.Quantity} {Model.Unit}")
                    }
                    else
                    {
                        <span class="text-red-600">Out of stock</span>
                    }
                </dd>

                <dt class="text-gray-500">Best before</dt>
                <dd class="text-gray-900 font-medium">
                    @if (Model.BestBefore != default)
                    {
                        @Model.BestBefore.ToString("dd MMM yyyy")
                    }
                    else
                    {
                        <span class="text-gray-400">—</span>
                    }
                </dd>

                <dt class="text-gray-500">Delivery</dt>
                <dd class="text-gray-900 font-medium">
                    @if (isDeliverable && !string.IsNullOrWhiteSpace(Model.DeliveryRadius))
                    {
                        <span>Available within @Model.DeliveryRadius</span>
                    }
                    else if (isDeliverable)
                    {
                        <span>Available for delivery</span>
                    }
                    else
                    {
                        <span class="text-gray-400">Not available for this item</span>
                    }
                </dd>
            </dl>

            <!-- Actions -->
            <div class="mt-8 pt-6 border-t border-golden-100 flex flex-wrap gap-3">

                @if (inStock)
                {
                    <a asp-controller="Bookings" asp-action="Create"
                       asp-route-inventoryId="@Model.ID"
                       class="btn-primary w-auto px-6">
                        Book for pickup
                    </a>

                    @if (isDeliverable)
                    {
                        <a asp-controller="Deliveries" asp-action="Create"
                           asp-route-inventoryId="@Model.ID"
                           class="btn-secondary">
                            Request delivery
                        </a>
                    }
                }
                else
                {
                    <button type="button" disabled
                            class="btn-primary w-auto px-6 opacity-50 cursor-not-allowed">
                        Out of stock
                    </button>
                }

                <a asp-action="Index" class="btn-secondary">Back to shop</a>
            </div>

            <!-- Not-deliverable note -->
            @if (inStock && !isDeliverable)
            {
                <p class="mt-3 text-xs text-gray-500">
                    This item can only be picked up from the shop — delivery is not available.
                </p>
            }
        </div>
    </div>
</div>