@model IEnumerable<Shop_Management_System.Models.Inventory>
@using Shop_Management_System.Models
@using Shop_Management_System.Extensions
@{
    ViewData["Title"] = "Shop";
}

<div class="max-w-7xl mx-auto">

    <!-- Page header -->
    <div class="mb-8">
        <h1 class="text-2xl font-bold text-gray-900">Shop</h1>
        <p class="mt-1 text-sm text-gray-600">Browse our available products.</p>
    </div>

    <!-- Search + filter -->
    <form asp-action="Index" method="get"
          class="mb-8 flex flex-col sm:flex-row sm:items-center gap-3">
        <div class="relative flex-1 max-w-md">
            <svg class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-gray-400"
                 fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="m21 21-4.35-4.35M17 10.5a6.5 6.5 0 1 1-13 0 6.5 6.5 0 0 1 13 0Z" />
            </svg>
            <input name="searchName" value="@ViewData["SearchName"]"
                   placeholder="Search products..."
                   class="form-input pl-9" />
        </div>

        <select name="category" class="form-input sm:max-w-xs">
            <option value="">All categories</option>
            @foreach (var c in Enum.GetValues<CategoriesChoices>())
            {
                var selected = (CategoriesChoices?)ViewData["SelectedCategory"] == c;
                <option value="@c" selected="@selected">@c.GetDisplayName()</option>
            }
        </select>

        <div class="flex items-center gap-2">
            <button type="submit" class="btn-primary w-auto px-6">Search</button>
            @if (!string.IsNullOrWhiteSpace(ViewData["SearchName"]?.ToString())
                 || ViewData["SelectedCategory"] != null)
            {
                <a asp-action="Index" class="btn-secondary">Clear</a>
            }
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="card p-12 text-center">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-golden-50">
                <svg class="h-6 w-6 text-golden-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="m21 21-4.35-4.35M17 10.5a6.5 6.5 0 1 1-13 0 6.5 6.5 0 0 1 13 0Z" />
                </svg>
            </div>
            <h3 class="mt-4 text-base font-semibold text-gray-900">No products found</h3>
            <p class="mt-1 text-sm text-gray-600">Try adjusting your search or filters.</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var item in Model)
            {
                var inStock = item.Quantity > 0;
                var isDeliverable = item.Is_Delivarable;

                <div class="card overflow-hidden flex flex-col group
                            hover:shadow-md hover:border-golden-200 transition-all">

                    <!-- Image -->
                    <div class="relative h-48 w-full overflow-hidden bg-golden-50">
                        @if (!string.IsNullOrEmpty(item.ImagePath))
                        {
                            <img src="@item.ImagePath" alt="@item.Name"
                                 class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-300" />
                        }
                        else
                        {
                            <div class="h-full w-full flex items-center justify-center text-golden-400">
                                <svg class="h-12 w-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                          d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                            </div>
                        }

                        @if (!inStock)
                        {
                            <div class="absolute inset-0 bg-black/40 flex items-center justify-center">
                                <span class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-gray-900">
                                    Out of stock
                                </span>
                            </div>
                        }
                        else if (isDeliverable)
                        {
                            <span class="absolute top-2 right-2 inline-flex items-center gap-1 rounded-full bg-white/95 px-2.5 py-1 text-xs font-medium text-golden-700 border border-golden-200 shadow-sm">
                                <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M3 7h11v8H3zM14 10h4l3 3v2h-7zM5.5 19a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Zm13 0a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z" />
                                </svg>
                                Delivery
                            </span>
                        }
                    </div>

                    <!-- Body -->
                    <div class="p-5 flex-1 flex flex-col">

                        <!-- Name + category -->
                        <div class="flex items-start justify-between gap-2">
                            <h3 class="font-semibold text-gray-900 truncate" title="@item.Name">@item.Name</h3>
                        </div>

                        @if (item.Categories.HasValue)
                        {
                            <span class="mt-1 inline-block self-start rounded-full bg-golden-50 border border-golden-200
                                px-2.5 py-0.5 text-xs font-medium text-golden-700">
                                @item.Categories.Value.GetDisplayName()
                            </span>
                        }

                        <!-- Description -->
                        <p class="mt-3 text-sm text-gray-600 line-clamp-2 flex-1">
                            @item.Description
                        </p>

                        <!-- Price + stock -->
                        <div class="mt-4 flex items-baseline justify-between gap-3">
                            <span class="text-lg font-bold text-golden-700 whitespace-nowrap">
                                KES @item.SellingPrice.ToString("N2")
                            </span>
                            <span class="text-xs @(inStock ? "text-gray-500" : "text-red-600 font-medium") whitespace-nowrap">
                                @if (inStock)
                                {
                                    @($"{item.Quantity} {item.Unit} in stock")
                                }
                                else
                                {
                                    @("Out of stock")
                                }
                            </span>
                        </div>

                        <!-- Actions -->
                        <div class="mt-4 flex gap-2">
                            <a asp-action="Details" asp-route-id="@item.ID"
                               class="btn-secondary flex-1">
                                View
                            </a>

                            @if (!User.Identity!.IsAuthenticated)
                            {
                                <a asp-area="Identity" asp-page="/Account/Login"
                                   asp-route-returnUrl="@Context.Request.Path"
                                   class="btn-primary flex-1">
                                    Login to book
                                </a>
                            }
                            else if (inStock)
                            {
                                <a asp-controller="Bookings" asp-action="Create"
                                   asp-route-inventoryId="@item.ID"
                                   class="btn-primary flex-1">
                                    Book
                                </a>
                            }
                            else
                            {
                                <button type="button" disabled
                                        class="btn-primary flex-1 opacity-50 cursor-not-allowed">
                                    Book
                                </button>
                            }
                        </div>

                        <!-- Delivery action (secondary, below the main buttons) -->
                        @if (isDeliverable && inStock)
                        {
                            @if (!User.Identity!.IsAuthenticated)
                            {
                                <a asp-area="Identity" asp-page="/Account/Login"
                                   asp-route-returnUrl="@Context.Request.Path"
                                   class="mt-2 block text-center text-xs font-medium text-golden-700
                                    hover:text-golden-800 hover:underline underline-offset-2 transition-colors">
                                    Login to request delivery →
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Deliveries" asp-action="Create"
                                   asp-route-inventoryId="@item.ID"
                                   class="mt-2 block text-center text-xs font-medium text-golden-700
                                    hover:text-golden-800 hover:underline underline-offset-2 transition-colors">
                                    Request delivery →
                                </a>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>