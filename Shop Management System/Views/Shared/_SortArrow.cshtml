@model string

@if (Model == "asc")
{
    <svg class="h-3 w-3 text-golden-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="m5 15 7-7 7 7" />
    </svg>
}
else if (Model == "desc")
{
    <svg class="h-3 w-3 text-golden-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="m19 9-7 7-7-7" />
    </svg>
}
else
{
    <svg class="h-3 w-3 text-gray-300 group-hover:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8 9l4-4 4 4M16 15l-4 4-4-4" />
    </svg>
}