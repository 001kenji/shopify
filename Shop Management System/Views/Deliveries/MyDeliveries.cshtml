@model IEnumerable<Shop_Management_System.Models.Delivery>
@using Shop_Management_System.Models

@functions {
    (string chipClass, string dotClass) DeliveryStatusStyle(DeliveryStatus status) => status switch
    {
        DeliveryStatus.Pending        => ("bg-yellow-50 border-yellow-200 text-yellow-700", "bg-yellow-500"),
        DeliveryStatus.Confirmed      => ("bg-green-50 border-green-200 text-green-700",   "bg-green-500"),
        DeliveryStatus.OutForDelivery => ("bg-blue-50 border-blue-200 text-blue-700",      "bg-blue-500"),
        DeliveryStatus.Delivered      => ("bg-gray-50 border-gray-200 text-gray-700",      "bg-gray-400"),
        DeliveryStatus.Cancelled      => ("bg-red-50 border-red-200 text-red-700",         "bg-red-500"),
        _                             => ("bg-gray-50 border-gray-200 text-gray-700",      "bg-gray-400"),
    };

    string DeliveryRowAccent(DeliveryStatus status) => status switch
    {
        DeliveryStatus.Pending        => "border-l-4 border-l-yellow-400",
        DeliveryStatus.Confirmed      => "border-l-4 border-l-green-400",
        DeliveryStatus.OutForDelivery => "border-l-4 border-l-blue-400",
        DeliveryStatus.Delivered      => "border-l-4 border-l-gray-300",
        DeliveryStatus.Cancelled      => "border-l-4 border-l-red-400",
        _                             => "border-l-4 border-l-gray-300",
    };
}
@{
    ViewData["Title"] = "My Deliveries";
}



<div class="max-w-5xl mx-auto">

    <div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">My Deliveries</h1>
            <p class="mt-1 text-sm text-gray-600">Track the deliveries you've requested.</p>
        </div>
        <a asp-controller="Shop" asp-action="Index" class="btn-secondary w-fit">Browse shop</a>
    </div>

    @if (!Model.Any())
    {
        <div class="card p-12 text-center">
            <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-full bg-golden-50 border border-golden-200">
                <svg class="h-8 w-8 text-golden-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M3 7h13l3 5v5h-2M3 7v10h2m0 0a2 2 0 104 0m-4 0a2 2 0 014 0m9 0a2 2 0 11-4 0m4 0a2 2 0 10-4 0" />
                </svg>
            </div>
            <h2 class="mt-4 text-lg font-semibold text-gray-900">No deliveries yet</h2>
            <p class="mt-1 text-sm text-gray-600">Request a delivery from the shop and it will appear here.</p>
            <a asp-controller="Shop" asp-action="Index" class="btn-primary w-auto px-6 mt-6 inline-flex">
                Start shopping
            </a>
        </div>
    }
    else
    {
        <div class="space-y-4">
            @foreach (var d in Model)
            {
                var item = d.Inventory;
                var isPast = d.DateDelivered < DateTime.Now;
                var status = d.Status;
                var (chipClass, dotClass) = DeliveryStatusStyle(status);
                var itemName = item?.Name ?? $"Item #{d.InventoryID}";
                var unit = string.IsNullOrWhiteSpace(item?.Unit) ? "pcs" : item!.Unit;
                var showPastWarning = isPast
                    && status != DeliveryStatus.Delivered
                    && status != DeliveryStatus.Cancelled;

                <div class="card p-5">

                    <div class="flex items-start justify-between gap-4 mb-4">
                        <div class="min-w-0">
                            <h3 class="font-semibold text-gray-900 truncate" title="@itemName">@itemName</h3>
                            <p class="text-xs text-gray-500 font-mono mt-0.5">#@d.Id.ToString("D6")</p>
                        </div>
                        <span class="inline-flex items-center gap-1.5 rounded-full border @chipClass
                                     px-3 py-0.5 text-xs font-medium whitespace-nowrap">
                            <span class="h-1.5 w-1.5 rounded-full @dotClass"></span>
                            @status
                        </span>
                    </div>

                    <dl class="grid grid-cols-2 sm:grid-cols-4 gap-x-4 gap-y-3 text-sm">
                        <div>
                            <dt class="text-gray-500 text-xs">Quantity</dt>
                            <dd class="font-medium text-gray-900">@d.Quantity @unit</dd>
                        </div>
                        <div>
                            <dt class="text-gray-500 text-xs">Location</dt>
                            <dd class="font-medium text-gray-900 truncate" title="@d.Location">@d.Location</dd>
                        </div>
                        <div>
                            <dt class="text-gray-500 text-xs">Delivery date</dt>
                            <dd class="font-medium @(showPastWarning ? "text-red-600" : "text-gray-900")">
                                @d.DateDelivered.ToString("dd MMM yyyy")
                            </dd>
                        </div>
                        <div>
                            <dt class="text-gray-500 text-xs">Total</dt>
                            <dd class="font-bold text-golden-700">KES @d.Amount.ToString("N2")</dd>
                        </div>
                    </dl>

                    <div class="mt-4 flex flex-wrap items-center gap-2">
                        <a asp-action="Details" asp-route-id="@d.Id" class="btn-secondary-sm">View details</a>

                        @if (status == DeliveryStatus.Pending)
                        {
                            <a asp-action="Edit" asp-route-id="@d.Id" class="btn-secondary-sm">Edit</a>

                            <form asp-action="Cancel" asp-route-id="@d.Id" method="post" class="inline"
                                  onsubmit="return confirm('Cancel this delivery?');">
                                <button type="submit" class="btn-danger-sm">Cancel</button>
                            </form>
                        }
                    </div>

                    @if (showPastWarning)
                    {
                        <p class="mt-3 text-xs text-red-600">
                            Delivery date has passed. Contact the shop if you haven't received it.
                        </p>
                    }
                </div>
            }
        </div>
    }
</div>