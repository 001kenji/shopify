@model Shop_Management_System.Models.Delivery
@using Shop_Management_System.Models
@using Shop_Management_System.Extensions
@{
    ViewData["Title"] = "Delivery Requested";

    var inventory = Model.Inventory;
    var unit = string.IsNullOrWhiteSpace(inventory?.Unit) ? "pcs" : inventory!.Unit;
    var reference = $"#{Model.Id:D6}";
    var deliveryCost = Model.DeliveryCost;
    var grandTotal = Model.Amount + deliveryCost;
}

@functions {
    (string chipClass, string dotClass) DeliveryStatusStyle(DeliveryStatus status) => status switch
    {
        DeliveryStatus.PendingPayment        => ("bg-yellow-50 border-yellow-200 text-yellow-700", "bg-yellow-500"),
        DeliveryStatus.PendingConfimation    => ("bg-yellow-50 border-yellow-200 text-yellow-700", "bg-yellow-500"),
        DeliveryStatus.Confirmed             => ("bg-green-50 border-green-200 text-green-700",   "bg-green-500"),
        DeliveryStatus.OutForDelivery        => ("bg-blue-50 border-blue-200 text-blue-700",      "bg-blue-500"),
        DeliveryStatus.Delivered             => ("bg-gray-50 border-gray-200 text-gray-700",      "bg-gray-400"),
        DeliveryStatus.Cancelled             => ("bg-red-50 border-red-200 text-red-700",         "bg-red-500"),
        _                                    => ("bg-gray-50 border-gray-200 text-gray-700",      "bg-gray-400"),
    };

    string DeliveryRowAccent(DeliveryStatus status) => status switch
    {
        DeliveryStatus.PendingPayment        => "border-l-4 border-l-yellow-400",
        DeliveryStatus.PendingConfimation    => "border-l-4 border-l-yellow-400",
        DeliveryStatus.Confirmed             => "border-l-4 border-l-green-400",
        DeliveryStatus.OutForDelivery        => "border-l-4 border-l-blue-400",
        DeliveryStatus.Delivered             => "border-l-4 border-l-gray-300",
        DeliveryStatus.Cancelled             => "border-l-4 border-l-red-400",
        _                                    => "border-l-4 border-l-gray-300",
    };
}

<div class="max-w-2xl mx-auto">
    <div class="mb-8 text-center">
        <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-full bg-yellow-50 border border-yellow-200">
            <svg class="h-8 w-8 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
            </svg>
        </div>
        <h1 class="mt-4 text-2xl font-bold text-gray-900">Payment required</h1>
        <p class="mt-1 text-sm text-gray-600">
            Complete payment to finalise your delivery request.
        </p>
    </div>

    <div class="card p-6 sm:p-8">
        <div class="flex items-center justify-between mb-6">
            <h2 class="text-lg font-semibold text-gray-900">Delivery @reference</h2>
            <span class="inline-block rounded-full bg-yellow-50 border border-yellow-200
                         px-3 py-0.5 text-xs font-medium text-yellow-700 whitespace-nowrap">
                Pending payment
            </span>
        </div>

        <dl class="grid grid-cols-2 gap-x-6 gap-y-4 text-sm">
            <div>
                <dt class="text-gray-500">Item</dt>
                <dd class="font-medium text-gray-900">@(inventory?.Name ?? $"Item #{Model.InventoryID}")</dd>
            </div>
            <div>
                <dt class="text-gray-500">Quantity</dt>
                <dd class="font-medium text-gray-900">@Model.Quantity @unit</dd>
            </div>
            <div>
                <dt class="text-gray-500">Location</dt>
                <dd class="font-medium text-gray-900">@Model.Location</dd>
            </div>
            <div>
                <dt class="text-gray-500">Delivery date</dt>
                <dd class="font-medium text-gray-900">
                    @Model.DateDelivered.ToString("dd MMM yyyy")
                </dd>
            </div>
        </dl>

        <!-- Price breakdown -->
        <dl class="mt-6 space-y-2 text-sm border-t border-golden-100 pt-4">
            <div class="flex justify-between">
                <dt class="text-gray-500">Items subtotal</dt>
                <dd class="font-medium text-gray-900">KES @Model.Amount.ToString("N2")</dd>
            </div>
            <div class="flex justify-between">
                <dt class="text-gray-500">Delivery cost</dt>
                <dd class="font-medium text-gray-900">
                    @(deliveryCost > 0 ? $"KES {deliveryCost:N2}" : "Free")
                </dd>
            </div>
            <div class="flex justify-between border-t border-golden-100 pt-2">
                <dt class="font-semibold text-gray-900">Total to pay</dt>
                <dd class="font-bold text-golden-700">KES @grandTotal.ToString("N2")</dd>
            </div>
        </dl>

        <div class="mt-6 alert-warning">
            <svg class="h-5 w-5 shrink-0 text-golden-600 mt-0.5" fill="none"
                 stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <div>
                <p class="font-medium">Complete payment to continue</p>
                <p class="mt-1 text-sm">
                    Your delivery won't be processed until payment is received.
                    Keep reference <span class="font-mono font-semibold">@reference</span> handy.
                </p>
            </div>
        </div>
    </div>

    <div class="mt-6 flex flex-wrap items-center gap-3">
        <a asp-controller="Payments"
           asp-action="Create"
           asp-route-Id="@Model.Id"
           asp-route-serviceScope="@ServiceType.DELIVER"
           class="btn-primary w-auto px-6">
            Pay KES @grandTotal.ToString("N2")
        </a>

        <a asp-action="MyDeliveries" class="btn-secondary">My deliveries</a>

        <a asp-controller="Shop" asp-action="Index"
           class="sm:ml-auto text-sm link-golden">
            Continue shopping
        </a>
    </div>
</div>