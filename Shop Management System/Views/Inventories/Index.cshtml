@model IEnumerable<Shop_Management_System.Models.Inventory>
@using Shop_Management_System.Models
@using Shop_Management_System.Extensions
@{
    ViewData["Title"] = "Inventory";

    var currentSort = ViewData["CurrentSort"]?.ToString();
    var searchName = ViewData["SearchName"]?.ToString();
    var category = ViewData["SelectedCategory"] as CategoriesChoices?;
    var hasFilters = !string.IsNullOrWhiteSpace(searchName) || category != null;

    // Build a route-values dict for sort links so filter state carries through
    var routeValues = new Dictionary<string, string?>
    {
        ["searchName"] = searchName,
        ["category"] = category?.ToString(),
    };

    string NextSort(string asc, string desc) =>
        currentSort == asc ? desc : asc;

    bool IsActive(string sortKey) =>
        currentSort == sortKey || currentSort == sortKey.Replace("_asc", "_desc");

    bool IsAscending(string sortKey) => currentSort == sortKey;
    bool IsDescending(string sortKey) => currentSort == sortKey.Replace("_asc", "_desc");
}



<div class="flex items-center justify-between mb-8">
    <div>
        <h1 class="text-2xl font-bold text-gray-900">Inventory</h1>
        <p class="mt-1 text-sm text-gray-600">Manage all shop items.</p>
    </div>
    <a asp-action="Create" class="btn-primary w-auto px-5">
        <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        Create New
    </a>
</div>

<!-- Search + filter -->
<form asp-action="Index" asp-controller="Inventories" method="get"
      class="mb-6 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">

    <div class="relative flex-1 max-w-md">
        <svg class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-gray-400"
             fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="m21 21-4.35-4.35M17 10.5a6.5 6.5 0 1 1-13 0 6.5 6.5 0 0 1 13 0Z" />
        </svg>
        <input name="SearchName" value="@searchName"
               placeholder="Search by name..."
               class="form-input pl-9" />
    </div>

    <select name="category" class="form-input sm:max-w-xs">
        <option value="">All categories</option>
        @foreach (var c in Enum.GetValues<CategoriesChoices>())
        {
            var selected = category == c;
            <option value="@c" selected="@selected">@c.GetDisplayName()</option>
        }
    </select>

    @* Preserve the current sort when filtering *@
    @if (!string.IsNullOrEmpty(currentSort))
    {
        <input type="hidden" name="sortOrder" value="@currentSort" />
    }

    <div class="flex items-center gap-2">
        <button type="submit" class="btn-primary w-auto px-6">Search</button>
        @if (hasFilters)
        {
            <a asp-action="Index" class="btn-secondary">Clear</a>
        }
    </div>
</form>

@if (!Model.Any())
{
    <div class="card p-12 text-center">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-golden-50">
            <svg class="h-6 w-6 text-golden-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M20 7 12 3 4 7m16 0-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
            </svg>
        </div>
        <h3 class="mt-4 text-base font-semibold text-gray-900">No items found</h3>
        <p class="mt-1 text-sm text-gray-600">
            @if (!string.IsNullOrWhiteSpace(searchName))
            {
                <span>No items match &ldquo;@searchName&rdquo;.</span>
            }
            else
            {
                <span>Get started by adding your first inventory item.</span>
            }
        </p>
        <a asp-action="Create" class="btn-primary w-auto px-6 mt-6 inline-flex">Create New</a>
    </div>
}
else
{
    <div class="card overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-golden-100">
                <thead class="bg-golden-50">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-golden-800">Image</th>

                        @* Sortable: Name *@
                        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-golden-800">
                            <a asp-action="Index"
                               asp-all-route-data="routeValues"
                               asp-route-sortOrder="@NextSort("name_asc", "name_desc")"
                               class="inline-flex items-center gap-1 hover:text-golden-600 transition-colors">
                                Name
                                <partial name="_SortArrow" model="@(IsAscending("name_asc") ? "asc" : IsDescending("name_desc") ? "desc" : "none")" />
                            </a>
                        </th>

                        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-golden-800">Description</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-golden-800">Category</th>

                        @* Sortable: Qty *@
                        <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-golden-800">
                            <a asp-action="Index"
                               asp-all-route-data="routeValues"
                               asp-route-sortOrder="@NextSort("qty_asc", "qty_desc")"
                               class="inline-flex items-center gap-1 hover:text-golden-600 transition-colors">
                                Qty
                                <partial name="_SortArrow" model="@(IsAscending("qty_asc") ? "asc" : IsDescending("qty_desc") ? "desc" : "none")" />
                            </a>
                        </th>

                        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-golden-800">Unit</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-golden-800">Best Before</th>
                        <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-golden-800">Buying</th>

                        @* Sortable: Selling price *@
                        <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-golden-800">
                            <a asp-action="Index"
                               asp-all-route-data="routeValues"
                               asp-route-sortOrder="@NextSort("price_asc", "price_desc")"
                               class="inline-flex items-center gap-1 hover:text-golden-600 transition-colors">
                                Selling
                                <partial name="_SortArrow" model="@(IsAscending("price_asc") ? "asc" : IsDescending("price_desc") ? "desc" : "none")" />
                            </a>
                        </th>

                        <th class="px-4 py-3 text-center text-xs font-semibold uppercase tracking-wider text-golden-800">Delivery</th>
                        <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-golden-800">Radius</th>
                        <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-golden-800">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-golden-100 bg-white">
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-golden-50/50 transition-colors">
                            <td class="px-4 py-3">
                                @if (!string.IsNullOrWhiteSpace(item.ImagePath))
                                {
                                    <img src="@item.ImagePath" alt="@item.Name"
                                         class="h-12 w-12 rounded-md object-cover border border-golden-200" />
                                }
                                else
                                {
                                    <div class="h-12 w-12 rounded-md bg-golden-50 border border-golden-200 flex items-center justify-center">
                                        <svg class="h-5 w-5 text-golden-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                  d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909M3.75 21h16.5M4.5 3.75h15A2.25 2.25 0 0 1 21.75 6v12a2.25 2.25 0 0 1-2.25 2.25h-15A2.25 2.25 0 0 1 2.25 18V6A2.25 2.25 0 0 1 4.5 3.75Z" />
                                        </svg>
                                    </div>
                                }
                            </td>
                            <td class="px-4 py-3 text-sm font-medium text-gray-900 whitespace-nowrap">
                                @Html.DisplayFor(model => item.Name)
                            </td>
                            <td class="px-4 py-3 text-sm text-gray-700 max-w-xs truncate" title="@item.Description">
                                @Html.DisplayFor(model => item.Description)
                            </td>
                            <td class="px-4 py-3 text-sm">
                                @if (!string.IsNullOrWhiteSpace(item.Categories?.GetDisplayName()))
                                {
                                    <span class="inline-flex items-center rounded-full bg-golden-50 px-2.5 py-0.5 text-xs font-medium text-golden-700 border border-golden-200 whitespace-nowrap">
                                        @item.Categories.GetDisplayName()
                                    </span>
                                }
                                else
                                {
                                    <span class="text-gray-400">—</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-sm text-gray-700 text-right whitespace-nowrap">
                                @Html.DisplayFor(model => item.Quantity)
                            </td>
                            <td class="px-4 py-3 text-sm">
                                @if (!string.IsNullOrWhiteSpace(item.Unit))
                                {
                                    <span class="inline-flex items-center rounded-full bg-golden-50 px-2.5 py-0.5 text-xs font-medium text-golden-700 border border-golden-200 whitespace-nowrap">
                                        @Html.DisplayFor(model => item.Unit)
                                    </span>
                                }
                                else
                                {
                                    <span class="text-gray-400">—</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-sm text-gray-700 whitespace-nowrap">
                                @Html.DisplayFor(model => item.BestBefore)
                            </td>
                            <td class="px-4 py-3 text-sm text-gray-700 text-right whitespace-nowrap">
                                @Html.DisplayFor(model => item.BuyingPrice)
                            </td>
                            <td class="px-4 py-3 text-sm font-medium text-golden-700 text-right whitespace-nowrap">
                                @Html.DisplayFor(model => item.SellingPrice)
                            </td>
                            <td class="px-4 py-3 text-sm text-center">
                                @if (item.Is_Delivarable)
                                {
                                    <span class="inline-flex items-center gap-1 rounded-full bg-golden-50 px-2.5 py-0.5 text-xs font-medium text-golden-700 border border-golden-200">
                                        <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m5 13 4 4L19 7" />
                                        </svg>
                                        Yes
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center rounded-full bg-gray-50 px-2.5 py-0.5 text-xs font-medium text-gray-600 border border-gray-200">
                                        No
                                    </span>
                                }
                            </td>
                            <td class="px-4 py-3 text-sm text-gray-700 text-right whitespace-nowrap">
                                @if (!string.IsNullOrWhiteSpace(item.DeliveryRadius))
                                {
                                    @Html.DisplayFor(model => item.DeliveryRadius)
                                }
                                else
                                {
                                    <span class="text-gray-400">—</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-right whitespace-nowrap">
                                <div class="inline-flex items-center gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.ID" class="btn-secondary-sm">Edit</a>
                                    <a asp-action="Details" asp-route-id="@item.ID" class="btn-secondary-sm">Details</a>
                                    <a asp-action="Delete" asp-route-id="@item.ID" class="btn-danger-sm">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}