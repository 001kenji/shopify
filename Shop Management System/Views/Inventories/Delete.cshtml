@model Shop_Management_System.Models.Inventory

@{
    ViewData["Title"] = "Delete";
}

<div class="max-w-2xl mx-auto">
    <div class="mb-8">
        <nav class="text-sm text-gray-500 mb-2">
            <a asp-action="Index" class="hover:text-golden-600 transition-colors">Inventory</a>
            <span class="mx-1">/</span>
            <span class="text-gray-700">Delete</span>
        </nav>
        <h1 class="text-2xl font-bold text-gray-900">Delete Item</h1>
        <p class="mt-1 text-sm text-gray-600">This action cannot be undone.</p>
    </div>

    <div class="alert-danger">
        <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M12 9v3m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z" />
        </svg>
        <div>
            <strong>Are you sure you want to delete this?</strong>
            <p class="mt-1">Deleting <span class="font-semibold">@Model.Name</span> is permanent and cannot be recovered.</p>
        </div>
    </div>

    <div class="card mt-6 overflow-hidden">
        <dl class="divide-y divide-golden-100">
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 px-6 py-4">
                <dt class="text-sm font-medium text-gray-500">@Html.DisplayNameFor(model => model.Name)</dt>
                <dd class="sm:col-span-2 text-sm text-gray-900">@Html.DisplayFor(model => model.Name)</dd>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 px-6 py-4">
                <dt class="text-sm font-medium text-gray-500">@Html.DisplayNameFor(model => model.Description)</dt>
                <dd class="sm:col-span-2 text-sm text-gray-900">@Html.DisplayFor(model => model.Description)</dd>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 px-6 py-4">
                <dt class="text-sm font-medium text-gray-500">@Html.DisplayNameFor(model => model.Categories)</dt>
                <dd class="sm:col-span-2 text-sm text-gray-900">@Html.DisplayFor(model => model.Categories)</dd>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 px-6 py-4">
                <dt class="text-sm font-medium text-gray-500">@Html.DisplayNameFor(model => model.BestBefore)</dt>
                <dd class="sm:col-span-2 text-sm text-gray-900">@Html.DisplayFor(model => model.BestBefore)</dd>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 px-6 py-4">
                <dt class="text-sm font-medium text-gray-500">@Html.DisplayNameFor(model => model.BuyingPrice)</dt>
                <dd class="sm:col-span-2 text-sm text-gray-900">@Html.DisplayFor(model => model.BuyingPrice)</dd>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 px-6 py-4">
                <dt class="text-sm font-medium text-gray-500">@Html.DisplayNameFor(model => model.SellingPrice)</dt>
                <dd class="sm:col-span-2 text-sm text-gray-900">@Html.DisplayFor(model => model.SellingPrice)</dd>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 px-6 py-4">
                <dt class="text-sm font-medium text-gray-500">@Html.DisplayNameFor(model => model.Quantity)</dt>
                <dd class="sm:col-span-2 text-sm text-gray-900">@Html.DisplayFor(model => model.Quantity)</dd>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 px-6 py-4">
                <dt class="text-sm font-medium text-gray-500">@Html.DisplayNameFor(model => model.Is_Delivarable)</dt>
                <dd class="sm:col-span-2 text-sm text-gray-900">@Html.DisplayFor(model => model.Is_Delivarable)</dd>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 px-6 py-4">
                <dt class="text-sm font-medium text-gray-500">@Html.DisplayNameFor(model => model.DeliveryRadius)</dt>
                <dd class="sm:col-span-2 text-sm text-gray-900">@Html.DisplayFor(model => model.DeliveryRadius)</dd>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 px-6 py-4">
                <dt class="text-sm font-medium text-gray-500">@Html.DisplayNameFor(model => model.ImagePath)</dt>
                <dd class="sm:col-span-2 text-sm text-gray-900">@Html.DisplayFor(model => model.ImagePath)</dd>
            </div>
        </dl>
    </div>

    <form asp-action="Delete" class="mt-6 flex flex-wrap items-center gap-3">
        <input type="hidden" asp-for="ID" />
        <button type="submit" class="btn-danger px-6">Delete</button>
        <a asp-action="Index" class="btn-secondary">Back to List</a>
    </form>
</div>