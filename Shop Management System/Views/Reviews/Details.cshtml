@model Shop_Management_System.Models.Review
@using Shop_Management_System.Models
@using Shop_Management_System.Extensions
@{
    ViewData["Title"] = "Review Details";
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    var isOwner = isAuthenticated && User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == Model.UserId;
}

<div class="max-w-3xl mx-auto py-12">

    <!-- Breadcrumb -->
    <nav class="text-sm text-gray-500 mb-6">
        <a asp-action="Index" class="hover:text-golden-600 transition-colors">Reviews</a>
        <span class="mx-1">/</span>
        <span class="text-gray-700">#@Model.Id.ToString("D6")</span>
    </nav>

    <!-- Review card -->
    <div class="card p-6 sm:p-8">

        <!-- Header -->
        <div class="flex items-start justify-between gap-4 mb-6">
            <div class="min-w-0">
                <h1 class="text-xl font-bold text-gray-900">
                    @(Model.Inventory?.Name ?? $"Item #{Model.InventoryID}")
                </h1>
                <p class="mt-1 text-sm text-gray-600">
                    Reviewed by <span class="font-medium text-gray-900">@(ViewData["UserName"] ?? "—")</span>
                    · @Model.PostedOn.ToString("dd MMM yyyy")
                </p>
            </div>

            <!-- Rating stars -->
            <div class="flex items-center gap-1 shrink-0" title="@Model.Ratings.GetDisplayName()">
                @for (int i = 1; i <= 5; i++)
                {
                    var isFilled = (int)Model.Ratings >= i;
                    <svg class="h-5 w-5 @(isFilled ? "text-golden-400" : "text-gray-200")"
                         fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 0 0 .95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 0 0-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 0 0-1.176 0l-3.976 2.888c-.783.57-1.838-.196-1.538-1.118l1.518-4.674a1 1 0 0 0-.363-1.118L2.027 10.1c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 0 0 .951-.69l1.519-4.673Z" />
                    </svg>
                }
            </div>
        </div>

        <!-- Review body -->
        <div class="pt-6 border-t border-golden-100">
            <h2 class="text-xs font-semibold uppercase tracking-wide text-gray-500 mb-2">Review</h2>
            @if (!string.IsNullOrWhiteSpace(Model.Details))
            {
                <p class="text-sm text-gray-700 whitespace-pre-line leading-relaxed">@Model.Details</p>
            }
            else
            {
                <p class="text-sm text-gray-400 italic">No written review provided.</p>
            }
        </div>

        <!-- Likes -->
        <div class="mt-6 pt-6 border-t border-golden-100 flex items-center justify-between">
            <span class="text-xs text-gray-500 uppercase tracking-wide">Helpful votes</span>
            <span class="inline-flex items-center gap-1.5 text-sm font-medium text-golden-700">
                <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd"
                          d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656Z"
                          clip-rule="evenodd" />
                </svg>
                @Model.likes.Count
            </span>
        </div>

        <!-- Actions -->
        <div class="mt-8 pt-6 border-t border-golden-100 flex flex-wrap items-center gap-3">
            @if (isOwner)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-secondary">Edit</a>
            }
            <a asp-action="Index" class="btn-secondary">Back to list</a>
        </div>
    </div>
</div>