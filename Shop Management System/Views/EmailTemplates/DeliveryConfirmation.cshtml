@model Shop_Management_System.Services.EmailModels.DeliveryEmail
@{
    Layout = "~/Views/EmailTemplates/_EmailLayout.cshtml";
    ViewData["EmailTitle"] = "Delivery requested";
}

<h1 style="margin:0 0 16px 0; color:#c07d22; font-size:22px;">Delivery request received</h1>

<p style="margin:0 0 24px 0; line-height:1.6;">
    Hi @Model.UserName, your delivery request <strong>#@Model.Reference</strong> is pending review.
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0"
       style="border-collapse:collapse; margin-bottom:24px;">
    <tr>
        <td style="padding:8px 0; color:#666; font-size:13px;">Item</td>
        <td style="padding:8px 0; color:#333; font-size:13px; text-align:right; font-weight:600;">@Model.ItemName</td>
    </tr>
    <tr>
        <td style="padding:8px 0; color:#666; font-size:13px;">Quantity</td>
        <td style="padding:8px 0; color:#333; font-size:13px; text-align:right; font-weight:600;">@Model.Quantity @Model.Unit</td>
    </tr>
    <tr>
        <td style="padding:8px 0; color:#666; font-size:13px;">Delivery address</td>
        <td style="padding:8px 0; color:#333; font-size:13px; text-align:right; font-weight:600;">@Model.Location</td>
    </tr>
    <tr>
        <td style="padding:8px 0; color:#666; font-size:13px;">Requested date</td>
        <td style="padding:8px 0; color:#333; font-size:13px; text-align:right; font-weight:600;">@Model.DeliveryDate</td>
    </tr>
    <tr>
        <td style="padding:8px 0; color:#666; font-size:13px; border-top:1px solid #f4dfae;">Total</td>
        <td style="padding:8px 0; color:#c07d22; font-size:14px; text-align:right; font-weight:700; border-top:1px solid #f4dfae;">
            KES @Model.Total
        </td>
    </tr>
</table>

<p style="margin:0; font-size:13px; color:#666;">
    A shop admin will confirm your delivery shortly. You'll receive another email once it's on the way.
</p>