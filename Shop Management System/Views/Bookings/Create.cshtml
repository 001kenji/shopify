@model Shop_Management_System.Models.Booking

@{
    ViewData["Title"] = "Book Item";
    var inventoryName = ViewData["InventoryName"]?.ToString();
    var description = ViewData["Description"]?.ToString();
    var price = ViewData["InventoryPrice"];
    var availableQty = ViewData["AvailableQuantity"];
    var unit = ViewData["Unit"]?.ToString();
}

<div class="max-w-2xl mx-auto">
    <div class="mb-8">
        <nav class="text-sm text-gray-500 mb-2">
            <a asp-controller="Shop" asp-action="Index" class="hover:text-golden-600 transition-colors">Shop</a>
            <span class="mx-1">/</span>
            <span class="text-gray-700">Book</span>
        </nav>
        <h1 class="text-2xl font-bold text-gray-900">
            Book @(string.IsNullOrWhiteSpace(inventoryName) ? "this item" : inventoryName)
        </h1>
        <p class="mt-1 text-sm text-gray-600">Reserve this item for pickup at your convenience.</p>
    </div>

    <!-- Inventory summary -->
    @if (!string.IsNullOrWhiteSpace(inventoryName) || price != null)
    {
        <div class="card p-6 mb-6">
            <h2 class="text-xs font-semibold text-gray-900 uppercase tracking-wide mb-3">Item Summary</h2>
            <dl class="grid grid-cols-[140px_1fr] gap-x-4 gap-y-2 text-sm">
                @if (!string.IsNullOrWhiteSpace(inventoryName))
                {
                    <dt class="text-gray-500">Name</dt>
                    <dd class="text-gray-900 font-medium">@inventoryName</dd>
                }
                @if (!string.IsNullOrWhiteSpace(description))
                {
                    <dt class="text-gray-500">Description</dt>
                    <dd class="text-gray-700 whitespace-pre-line">@description</dd>
                }
                @if (price != null)
                {
                    <dt class="text-gray-500">Price</dt>
                    <dd class="font-semibold text-golden-700">KES @price</dd>
                }
                @if (availableQty != null)
                {
                    <dt class="text-gray-500">Available</dt>
                    <dd class="text-gray-900 font-medium">@availableQty @unit</dd>
                }
            </dl>
        </div>
    }

    <div class="card p-6 sm:p-8">
        <form asp-action="Create" class="space-y-5">
            <div asp-validation-summary="All" class="text-sm text-red-600" role="alert"></div>

            <input type="hidden" asp-for="InventoryID" />

            <div class="grid sm:grid-cols-2 gap-5">
                <div>
                    <label asp-for="Quantity" class="form-label">Quantity</label>
                    <input asp-for="Quantity" class="form-input" placeholder="0" />
                    <span asp-validation-for="Quantity" class="mt-1 block text-xs text-red-600"></span>
                </div>

                <div>
                    <label asp-for="PickingDuration" class="form-label">Picking Duration</label>
                    <input asp-for="PickingDuration" class="form-input" placeholder="e.g. 2 hours" />
                    <span asp-validation-for="PickingDuration" class="mt-1 block text-xs text-red-600"></span>
                </div>
            </div>

            <div class="flex items-center gap-3 pt-2 border-t border-golden-100">
                <button type="submit" class="btn-primary w-auto px-6">Confirm Booking</button>
                <a asp-controller="Shop" asp-action="Index" class="btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}