@model Shop_Management_System.Models.Booking

@{
    ViewData["Title"] = "Delete Booking";
}

<div class="max-w-2xl mx-auto">
    <div class="mb-8">
        <nav class="text-sm text-gray-500 mb-2">
            <a asp-action="Index" class="hover:text-golden-600 transition-colors">Bookings</a>
            <span class="mx-1">/</span>
            <span class="text-gray-700">Delete</span>
        </nav>
        <h1 class="text-2xl font-bold text-gray-900">Delete Booking</h1>
        <p class="mt-1 text-sm text-gray-600">This action cannot be undone.</p>
    </div>

    <div class="alert-danger">
        <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M12 9v3m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z" />
        </svg>
        <div>
            <strong>Are you sure you want to delete this?</strong>
            <p class="mt-1">This booking will be permanently removed.</p>
        </div>
    </div>

    <div class="card mt-6 overflow-hidden">
        <dl class="divide-y divide-golden-100">
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 px-6 py-4">
                <dt class="text-sm font-medium text-gray-500">Item</dt>
                <dd class="sm:col-span-2 text-sm text-gray-900">
                    @(Model.Inventory?.Name ?? $"Item #{Model.InventoryID}")
                </dd>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 px-6 py-4">
                <dt class="text-sm font-medium text-gray-500">User</dt>
                <dd class="sm:col-span-2 text-sm text-gray-900">
                    @(Model.User?.UserName ?? Model.UserId)
                </dd>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 px-6 py-4">
                <dt class="text-sm font-medium text-gray-500">Quantity</dt>
                <dd class="sm:col-span-2 text-sm text-gray-900">
                    @Html.DisplayFor(model => model.Quantity)
                </dd>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 px-6 py-4">
                <dt class="text-sm font-medium text-gray-500">Picking Duration</dt>
                <dd class="sm:col-span-2 text-sm text-gray-900">
                    @Html.DisplayFor(model => model.PickingDuration)
                </dd>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 px-6 py-4">
                <dt class="text-sm font-medium text-gray-500">Date Ordered</dt>
                <dd class="sm:col-span-2 text-sm text-gray-900">
                    @Model.DateOrdered.ToString("dd MMM yyyy, HH:mm")
                </dd>
            </div>
        </dl>
    </div>

    <form asp-action="Delete" class="mt-6 flex flex-wrap items-center gap-3">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn-danger px-6">Delete</button>
        <a asp-action="Index" class="btn-secondary">Back to List</a>
    </form>
</div>