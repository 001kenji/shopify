@model Shop_Management_System.Models.Payment
@using Shop_Management_System.Models
@using Shop_Management_System.Extensions
@{
    ViewData["Title"] = "Payment Details";
}

<div class="max-w-3xl mx-auto py-12">

    <!-- Header -->
    <div class="mb-8">
        <nav class="text-sm text-gray-500 mb-2">
            <a asp-action="Index" class="hover:text-golden-600 transition-colors">Payments</a>
            <span class="mx-1">/</span>
            <span class="text-gray-700">#@Model.id.ToString("D6")</span>
        </nav>
        <h1 class="text-2xl font-bold text-gray-900">Payment Details</h1>
        <p class="mt-1 text-sm text-gray-600">
            Record for payment #@Model.id.ToString("D6").
        </p>
    </div>

    <!-- Details card -->
    <div class="card overflow-hidden">
        <dl class="divide-y divide-golden-100">

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 px-6 py-4">
                <dt class="text-sm font-medium text-gray-500">Item</dt>
                <dd class="sm:col-span-2 text-sm font-medium text-gray-900">
                    @(string.IsNullOrWhiteSpace(Model.ItemName) ? "—" : Model.ItemName)
                </dd>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 px-6 py-4">
                <dt class="text-sm font-medium text-gray-500">Amount</dt>
                <dd class="sm:col-span-2 text-sm text-gray-900">@Model.Amount</dd>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 px-6 py-4">
                <dt class="text-sm font-medium text-gray-500">Quantity</dt>
                <dd class="sm:col-span-2 text-sm text-gray-900">@Model.Quantity</dd>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 px-6 py-4">
                <dt class="text-sm font-medium text-gray-500">Customer</dt>
                <dd class="sm:col-span-2 text-sm text-gray-900">
                    @(Model.User?.UserName ?? Model.UserId ?? "—")
                </dd>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 px-6 py-4">
                <dt class="text-sm font-medium text-gray-500">Payment method</dt>
                <dd class="sm:col-span-2 text-sm">
                    @if (Model.PaymentMethod != null)
                    {
                        <span class="inline-flex items-center rounded-full bg-golden-50 px-2.5 py-0.5 text-xs font-medium text-golden-700 border border-golden-200">
                            @Model.PaymentMethod.GetDisplayName()
                        </span>
                    }
                    else
                    {
                        <span class="text-gray-400">—</span>
                    }
                </dd>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 px-6 py-4">
                <dt class="text-sm font-medium text-gray-500">Payment date</dt>
                <dd class="sm:col-span-2 text-sm text-gray-900">
                    @Model.PaymentDate.ToString("dd MMM yyyy, HH:mm")
                </dd>
            </div>
        </dl>
    </div>

    <!-- Actions -->
    <div class="flex flex-wrap items-center gap-3 mt-6">
        <a asp-action="Index" class="btn-secondary">Back to List</a>
    </div>
</div>